{
  "ams": {
    "file-card": {
      "font-family": {
        "$value": "{ams.typography.font-family}",
        "$extensions": {
          "nl.amsterdam.type": "fontFamily"
        }
      },
      "font-size": {
        "$value": "{ams.typography.body-text.small.font-size}",
        "$extensions": {
          "nl.amsterdam.type": "fontSize"
        }
      },
      "font-weight": {
        "$value": "{ams.typography.body-text.font-weight}",
        "$extensions": {
          "nl.amsterdam.type": "fontWeight"
        }
      },
      "gap": {
        "$value": "{ams.space.s}",
        "$extensions": {
          "nl.amsterdam.subtype": "space",
          "nl.amsterdam.type": "dimension"
        }
      },
      "line-height": {
        "$value": "{ams.typography.body-text.small.line-height}",
        "$extensions": {
          "nl.amsterdam.subtype": "lineHeight",
          "nl.amsterdam.type": "number"
        }
      },
      "actions": {
        "gap": {
          "$value": "{ams.space.m}",
          "$extensions": {
            "nl.amsterdam.subtype": "space",
            "nl.amsterdam.type": "dimension"
          }
        }
      },
      "details": {
        "color": {
          "$value": "{ams.color.text.secondary}",
          "$extensions": {
            "nl.amsterdam.type": "color"
          }
        }
      },
      "info": {
        "flex-basis": {
          "$value": "12rem",
          "$description": "The width the name and details need beside the preview. When the actions do not fit beside them as well, the actions move below.",
          "$extensions": {
            "nl.amsterdam.type": "dimension"
          }
        }
      },
      "preview": {
        "width": {
          "$value": "clamp(2.5rem, 10vw, 5rem)",
          "$extensions": {
            "nl.amsterdam.type": "dimension"
          }
        }
      }
    }
  }
}
