{
  "ams": {
    "menu": {
      "background-color": {
        "$value": "{ams.color.interactive.default}",
        "$extensions": {
          "nl.amsterdam.type": "color"
        }
      },
      "font-family": {
        "$value": "{ams.typography.font-family}",
        "$extensions": {
          "nl.amsterdam.type": "fontFamily"
        }
      },
      "font-size": {
        "$value": "{ams.typography.body-text.font-size}",
        "$extensions": {
          "nl.amsterdam.type": "fontSize"
        }
      },
      "font-weight": {
        "$value": "{ams.typography.body-text.font-weight}",
        "$extensions": {
          "nl.amsterdam.type": "fontWeight"
        }
      },
      "line-height": {
        "$value": "{ams.typography.body-text.line-height}",
        "$extensions": {
          "nl.amsterdam.subtype": "lineHeight",
          "nl.amsterdam.type": "number"
        }
      },
      "padding-block": {
        "$value": "{ams.space.m}",
        "$extensions": {
          "nl.amsterdam.subtype": "space",
          "nl.amsterdam.type": "dimension"
        }
      },
      "wide": {
        "max-inline-size": {
          "$deprecated": "Use `ams.menu.vi-wide.max-inline-size` instead. Will be removed on or after 2026-10-20.",
          "$value": "{ams.menu.vi-wide.max-inline-size}",
          "$type": "dimension"
        },
        "padding-block": {
          "$deprecated": "Use `ams.menu.vi-wide.padding-block-start` and `ams.menu.vi-wide.padding-block-end` instead. Will be removed on or after 2026-10-20.",
          "$value": "{ams.menu.vi-wide.padding-block}",
          "$type": "dimension",
          "$extensions": {
            "nl.amsterdam.subtype": "space"
          }
        },
        "padding-inline": {
          "$deprecated": "Use `ams.menu.vi-wide.padding-inline` instead. Will be removed on or after 2026-10-20.",
          "$value": "{ams.menu.vi-wide.padding-inline}",
          "$type": "dimension",
          "$extensions": {
            "nl.amsterdam.subtype": "space"
          }
        }
      },
      "vi-wide": {
        "max-inline-size": {
          "$value": {
            "value": 8,
            "unit": "rem"
          },
          "$type": "dimension"
        },
        "padding-block": {
          "$deprecated": "Use `ams.menu.vi-wide.padding-block-start` and `ams.menu.vi-wide.padding-block-end` instead. Will be removed on or after 2027-04-25.",
          "$value": "{ams.menu.vi-wide.padding-block-start} {ams.menu.vi-wide.padding-block-end}",
          "$extensions": {
            "nl.amsterdam.subtype": "space",
            "nl.amsterdam.type": "dimension"
          }
        },
        "padding-block-end": {
          "$value": "{ams.space.m}",
          "$extensions": {
            "nl.amsterdam.subtype": "space",
            "nl.amsterdam.type": "dimension"
          }
        },
        "padding-block-start": {
          "$value": "calc(max({ams.logo.block-size}, {ams.logo.min-block-size}) + 2 * {ams.page-header.padding-block})",
          "$extensions": {
            "nl.amsterdam.subtype": "space",
            "nl.amsterdam.type": "dimension"
          }
        },
        "padding-inline": {
          "$deprecated": "Padding moved to link. Use `ams.menu.link.vi-wide.padding-inline` instead. Will be removed on or after 2027-04-25.",
          "$value": "0",
          "$extensions": {
            "nl.amsterdam.subtype": "space",
            "nl.amsterdam.type": "dimension"
          }
        }
      },
      "link": {
        "border-inline-end-color": {
          "$value": "transparent",
          "$type": "color"
        },
        "border-inline-end-style": {
          "$value": "solid",
          "$extensions": {
            "nl.amsterdam.type": "borderStyle"
          }
        },
        "border-inline-end-width": {
          "$value": "{ams.border.width.xl}",
          "$extensions": {
            "nl.amsterdam.type": "borderWidth"
          }
        },
        "border-inline-start-color": {
          "$value": "transparent",
          "$type": "color"
        },
        "border-inline-start-style": {
          "$value": "solid",
          "$extensions": {
            "nl.amsterdam.type": "borderStyle"
          }
        },
        "border-inline-start-width": {
          "$value": "{ams.border.width.xl}",
          "$extensions": {
            "nl.amsterdam.type": "borderWidth"
          }
        },
        "color": {
          "$value": "{ams.links.inverse.color}",
          "$extensions": {
            "nl.amsterdam.type": "color"
          }
        },
        "gap": {
          "$value": "{ams.space.s}",
          "$extensions": {
            "nl.amsterdam.subtype": "space",
            "nl.amsterdam.type": "dimension"
          }
        },
        "outline-offset": {
          "$value": "{ams.focus.outline-offset}",
          "$extensions": {
            "nl.amsterdam.subtype": "space",
            "nl.amsterdam.type": "dimension"
          }
        },
        "padding-block": {
          "$value": "{ams.space.s}",
          "$extensions": {
            "nl.amsterdam.subtype": "space",
            "nl.amsterdam.type": "dimension"
          }
        },
        "padding-inline": {
          "$value": "{ams.space.s}",
          "$extensions": {
            "nl.amsterdam.hint": "Must be a single value: it is used in a calculation, which two values would invalidate.",
            "nl.amsterdam.subtype": "space",
            "nl.amsterdam.type": "dimension"
          }
        },
        "text-decoration-line": {
          "$value": "{ams.links.subtle.text-decoration-line}",
          "$extensions": {
            "nl.amsterdam.type": "textDecorationLine"
          }
        },
        "text-decoration-thickness": {
          "$value": "{ams.links.text-decoration-thickness}",
          "$extensions": {
            "nl.amsterdam.subtype": "space",
            "nl.amsterdam.type": "dimension"
          }
        },
        "text-underline-offset": {
          "$value": "{ams.links.text-underline-offset}",
          "$extensions": {
            "nl.amsterdam.subtype": "space",
            "nl.amsterdam.type": "dimension"
          }
        },
        "hover": {
          "color": {
            "$value": "{ams.links.inverse.hover.color}",
            "$extensions": {
              "nl.amsterdam.type": "color"
            }
          },
          "text-decoration-line": {
            "$value": "{ams.links.subtle.hover.text-decoration-line}",
            "$extensions": {
              "nl.amsterdam.type": "textDecorationLine"
            }
          }
        },
        "current": {
          "background-color": {
            "$value": "color-mix(in srgb, {ams.menu.link.color} 12.5%, {ams.menu.background-color})",
            "$description": "Mixes the current color with the background color to create a subtle background for the current link.",
            "$extensions": {
              "nl.amsterdam.type": "color"
            }
          },
          "border-inline-start-color": {
            "$value": "currentColor",
            "$type": "color"
          },
          "border-inline-end-color": {
            "$value": "{ams.menu.link.current.background-color}",
            "$type": "color"
          },
          "color": {
            "$value": "{ams.menu.link.color}",
            "$extensions": {
              "nl.amsterdam.type": "color"
            }
          },
          "font-weight": {
            "$value": "{ams.typography.body-text.bold.font-weight}",
            "$type": "fontWeight"
          }
        },
        "wide": {
          "gap": {
            "$deprecated": "Use `ams.menu.link.vi-wide.gap` instead. Will be removed on or after 2026-10-20.",
            "$value": "{ams.menu.link.vi-wide.gap}",
            "$type": "dimension",
            "$extensions": {
              "nl.amsterdam.subtype": "space"
            }
          }
        },
        "vi-wide": {
          "current": {
            "border-inline-end-color": {
              "$value": "currentColor",
              "$type": "color"
            },
            "border-inline-start-color": {
              "$value": "{ams.menu.link.current.background-color}",
              "$type": "color"
            }
          },
          "gap": {
            "$value": "{ams.space.xs}",
            "$extensions": {
              "nl.amsterdam.subtype": "space",
              "nl.amsterdam.type": "dimension"
            }
          },
          "padding-inline": {
            "$value": "{ams.space.m}",
            "$extensions": {
              "nl.amsterdam.subtype": "space",
              "nl.amsterdam.type": "dimension"
            }
          }
        }
      },
      "list": {
        "gap": {
          "$value": "{ams.space.m}",
          "$extensions": {
            "nl.amsterdam.subtype": "space",
            "nl.amsterdam.type": "dimension"
          }
        }
      }
    }
  }
}
