{
  "ams": {
    "accordion": {
      "gap": {
        "$value": "{ams.space.s}",
        "$extensions": {
          "nl.amsterdam.subtype": "space",
          "nl.amsterdam.type": "dimension"
        }
      },
      "button": {
        "color": {
          "$value": "{ams.color.interactive.default}",
          "$extensions": {
            "nl.amsterdam.type": "color"
          }
        },
        "cursor": {
          "$value": "{ams.cursor.interactive}",
          "$extensions": {
            "nl.amsterdam.type": "cursor"
          }
        },
        "gap": {
          "$value": "{ams.space.s}",
          "$extensions": {
            "nl.amsterdam.subtype": "space",
            "nl.amsterdam.type": "dimension"
          }
        },
        "outline-offset": {
          "$value": "{ams.focus.outline-offset}",
          "$extensions": {
            "nl.amsterdam.subtype": "space",
            "nl.amsterdam.type": "dimension"
          }
        },
        "padding-block": {
          "$value": "{ams.space.s}",
          "$extensions": {
            "nl.amsterdam.subtype": "space",
            "nl.amsterdam.type": "dimension"
          }
        },
        "padding-inline": {
          "$value": "0",
          "$type": "dimension",
          "$extensions": {
            "nl.amsterdam.subtype": "space"
          }
        },
        "hover": {
          "color": {
            "$value": "{ams.color.interactive.hover}",
            "$extensions": {
              "nl.amsterdam.type": "color"
            }
          }
        },
        "icon": {
          "transition-duration": {
            "$value": "{ams.motion.transition.duration}",
            "$type": "duration"
          },
          "transition-timing-function": {
            "$value": "{ams.motion.transition.timing-function}",
            "$extensions": {
              "nl.amsterdam.type": "transitionTimingFunction"
            }
          },
          "svg-angle-start-rotate": {
            "$value": "{ams.motion.collapsible-toggle.rotate.angle-start}",
            "$type": "dimension"
          },
          "svg-angle-end-rotate": {
            "$value": "{ams.motion.collapsible-toggle.rotate.angle-end}",
            "$type": "dimension"
          }
        }
      }
    }
  }
}
