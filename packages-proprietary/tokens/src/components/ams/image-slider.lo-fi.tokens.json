{
  "ams": {
    "image-slider": {
      "thumbnails": {
        "thumbnail": {
          "background-color": {
            "$value": "#d1d1d1",
            "$type": "color"
          },
          "background-position": {
            "$value": "-100vw 0",
            "$description": "Moves the actual image out of view so the placeholder background shows.",
            "$extensions": {
              "nl.amsterdam.type": "backgroundPosition"
            }
          }
        }
      }
    }
  }
}
