{
  "ams": {
    "motion": {
      "transition": {
        "duration": {
          "$type": "duration",
          "$value": "0.3s",
          "$description": "Duration used for transitions."
        },
        "timing-function": {
          "$value": "ease",
          "$extensions": {
            "nl.amsterdam.type": "transitionTimingFunction"
          },
          "$description": "Timing function used for transitions."
        }
      },
      "collapsible": {
        "rotate": {
          "$type": "dimension",
          "$value": "0deg",
          "$description": "Rotation of the icon in the button of a collapsed section."
        },
        "expanded": {
          "rotate": {
            "$type": "dimension",
            "$value": "-180deg",
            "$description": "Rotation of the icon in the button of an expanded section."
          }
        }
      }
    }
  }
}
